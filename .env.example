# PostgreSQL — POSTGRES_* are consumed by docker-compose.yml, DATABASE_URL by the app
POSTGRES_USER=maitan
POSTGRES_PASSWORD=maitan
POSTGRES_DB=maitan_dev
DATABASE_URL=postgres://maitan:maitan@localhost:5432/maitan_dev

# Better Auth — generate the secret with: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-string
VITE_APP_URL=http://localhost:3000

# Resend — placeholders are fine locally; real key needed to send email
RESEND_API_KEY=re_placeholder
FROM_ADDRESS_EMAIL=Mai Tan <onboarding@resend.dev>
ADMIN_EMAIL=admin@example.com

# Cloudflare R2 — placeholders are fine locally; real values needed for image uploads
R2_ACCOUNT_ID=placeholder
R2_ACCESS_KEY_ID=placeholder
R2_SECRET_ACCESS_KEY=placeholder
R2_BUCKET_NAME=placeholder
R2_PUBLIC_URL=http://localhost:3000

# Sentry — optional, leave empty to disable
VITE_SENTRY_DSN=
VITE_SENTRY_ORG=
VITE_SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
