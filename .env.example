# Build-time and tooling configuration. Copy to `.env`.
# Everything here is read by Node — Drizzle Kit and the Vite build — never by the
# Worker at runtime. Worker secrets live in `.dev.vars`; see `.dev.vars.example`.

# Cloudflare D1 — only needed to talk to the *remote* database
# (`pnpm db:studio`, `drizzle-kit` against d1-http). Local development
# and `pnpm db:generate` work with these left empty.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=

# Exposed to the browser bundle; shown as the host affix on organization slugs
VITE_APP_URL=http://localhost:3000

# Sentry — optional, leave empty to disable
VITE_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
