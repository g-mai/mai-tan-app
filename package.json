{
  "name": "mai-tan-app",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "docker compose up -d && NODE_OPTIONS='--import ./instrument.server.mjs' vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "db:auth-generate": "npx auth generate --config ./src/features/auth/lib/auth.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:seed": "tsx --env-file=.env src/lib/db/seed.ts",
    "db:reset": "tsx --env-file=.env src/lib/db/seed.ts --reset",
    "db:purge-abandoned": "tsx --env-file=.env src/lib/db/purge-abandoned.ts",
    "db:studio": "drizzle-kit studio",
    "knip": "knip"
  },
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=11"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "~3.1109.0",
    "@aws-sdk/s3-request-presigner": "~3.1109.0",
    "@better-auth/drizzle-adapter": "^1.6.27",
    "@faker-js/faker": "~10.5.0",
    "@sentry/tanstackstart-react": "^10.70.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.10",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-router": "^1.170.27",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.44",
    "@tanstack/router-plugin": "^1.168.30",
    "@unpic/react": "^1.0.2",
    "better-auth": "^1.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "input-otp": "~1.5.0",
    "lucide-react": "^1.31.0",
    "nanoid": "~6.0.1",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-email": "6.9.2",
    "resend": "^6.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "ua-parser-js": "~2.0.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@netlify/vite-plugin-tanstack-start": "~1.3.17",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "^0.8.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "~7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "knip": "~6.32.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
