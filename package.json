{
  "name": "mai-tan-app",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "deploy": "vite build && wrangler deploy",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "db:auth-generate": "auth generate --config ./src/features/auth/lib/auth.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply mai-tan-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply mai-tan-db --remote",
    "db:studio": "drizzle-kit studio",
    "db:studio:local": "drizzle-kit studio --config=drizzle-local.config.ts",
    "knip": "knip"
  },
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=11"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.6",
    "@faker-js/faker": "~10.6.0",
    "@fontsource-variable/instrument-sans": "~5.3.0",
    "@fontsource-variable/jetbrains-mono": "~5.3.0",
    "@sentry/tanstackstart-react": "^10.75.3",
    "@t3-oss/env-core": "~0.13.11",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-query-devtools": "^5.103.2",
    "@tanstack/react-router": "^1.170.39",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.58",
    "@tanstack/router-plugin": "^1.168.40",
    "@unpic/react": "^1.0.2",
    "better-auth": "^1.7.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "input-otp": "~1.5.0",
    "lucide-react": "^1.47.0",
    "nanoid": "~6.0.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-email": "6.9.5",
    "resend": "^6.28.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "ua-parser-js": "~2.0.10",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@cloudflare/vite-plugin": "~1.59.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "^0.8.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "~7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "auth": "1.7.6",
    "better-sqlite3": "~13.0.3",
    "jsdom": "^30.1.1",
    "knip": "~6.38.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "~4.138.0"
  }
}
